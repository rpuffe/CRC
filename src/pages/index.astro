---
import Base from "@/layouts/Base.astro";
import SectionHeading from "@/components/SectionHeading.astro";
import { Badge } from "@/components/ui/badge";
import { Card, CardContent } from "@/components/ui/card";
import { Separator } from "@/components/ui/separator";
import { buttonVariants } from "@/components/ui/button";
import { FileText, MapPin } from "lucide-react";
import { profile, selectedWork, flightdeck } from "@/data/resume";

const nav = [
  { href: "#work", label: "Work" },
  { href: "#flightdeck", label: "Project" },
  { href: "/resume.html", label: "Résumé" },
  { href: "#contact", label: "Contact" },
];
---

<Base
  title="Robert Puffe | DevOps Lead"
  description="DevOps Lead at Eldermark running AWS infrastructure, Terraform, and CI/CD pipelines for two HIPAA-regulated healthcare platforms. Résumé, selected work, and contact."
  ogDescription="AWS, Terraform, CI/CD. DevOps Lead for two HIPAA-regulated healthcare platforms."
  nav={nav}
>
  <!-- Intro: who, what, at what scale, and where to go next -->
  <section class="relative isolate py-10 sm:py-16">
    <div class="hero-backdrop" aria-hidden="true"></div>
    <div class="flex items-center gap-4">
      <img
        src="/robert.jpg"
        alt="Robert Puffe playing guitar at a live show"
        width="72"
        height="72"
        class="ring-border size-16 shrink-0 rounded-full object-cover ring-1 sm:size-[72px]"
      />
      <div class="min-w-0">
        <h1 class="text-3xl font-semibold tracking-tight sm:text-4xl">{profile.name}</h1>
        <p class="text-muted-foreground mt-1 text-base sm:text-lg">
          <span class="text-foreground font-medium">{profile.title}</span> · {profile.focus.join(" · ")}
        </p>
      </div>
    </div>

    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-pretty sm:text-xl">{profile.plain}</p>
    <p class="text-muted-foreground mt-3 max-w-2xl leading-relaxed text-pretty">{profile.detail}</p>

    <p class="text-muted-foreground mt-4 flex items-center gap-1.5 text-sm">
      <MapPin className="size-4" aria-hidden="true" />
      {profile.location}
    </p>

    <div class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-3">
      <a href="/resume.html" class={buttonVariants({ size: "lg" })}>
        <FileText aria-hidden="true" /> Read my résumé
      </a>
      <a href={`mailto:${profile.email}`} class="link">{profile.email}</a>
    </div>
  </section>

  <Separator />

  <!-- Selected work: the problem, then what I did -->
  <section id="work" class="py-10 sm:py-14">
    <SectionHeading title="Selected work at Eldermark">
      <a href="/resume.html" class="link text-sm">Full résumé</a>
    </SectionHeading>
    <div class="grid gap-4 sm:grid-cols-2">
      {
        selectedWork.map((item) => (
          <Card className="py-0">
            <CardContent className="p-5">
              <h3 class="leading-snug font-semibold text-pretty">{item.title}</h3>
              <p class="text-muted-foreground mt-2 text-sm leading-relaxed">{item.problem}</p>
              <p class="mt-2 text-sm leading-relaxed">{item.change}</p>
            </CardContent>
          </Card>
        ))
      }
    </div>
  </section>

  <Separator />

  <!-- Personal project -->
  <section id="flightdeck" class="py-10 sm:py-14">
    <SectionHeading title="Personal project" />
    <h3 class="text-xl font-semibold tracking-tight">{flightdeck.name}</h3>
    <p class="mt-2 max-w-3xl leading-relaxed text-pretty">{flightdeck.plain} {flightdeck.lead}</p>
    <p class="text-muted-foreground mt-2 max-w-3xl leading-relaxed text-pretty">{flightdeck.facts}</p>
    <p class="text-muted-foreground mt-2 max-w-3xl leading-relaxed text-pretty">{flightdeck.credit}</p>
    <ul class="mt-4 flex flex-wrap gap-1.5" aria-label="Flightdeck technologies">
      {flightdeck.tags.map((tag) => <li><Badge variant="secondary">{tag}</Badge></li>)}
    </ul>
    <p class="mt-5 flex flex-wrap gap-x-5 gap-y-2">
      <a href="/projects.html" class="link">Read the case study</a>
      <a href={flightdeck.repo} target="_blank" rel="noopener noreferrer" class="link">Source on GitHub</a>
    </p>
  </section>

  <Separator />

  <!-- Contact -->
  <section id="contact" class="py-10 sm:py-14">
    <SectionHeading title="Contact" />
    <p class="max-w-xl leading-relaxed text-pretty">
      Email is the best way to reach me:{" "}
      <a href={`mailto:${profile.email}`} class="link">{profile.email}</a>
    </p>
    <p class="mt-3 flex flex-wrap gap-x-5 gap-y-2">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer" class="link">LinkedIn</a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer" class="link">GitHub</a>
      <a href="/resume.html" class="link">Résumé</a>
    </p>
  </section>

  <Fragment slot="footer">
    <p>
      <a class="hover:text-foreground underline underline-offset-4" href="https://github.com/rpuffe/CRC" target="_blank" rel="noopener noreferrer">Site source</a>
    </p>
  </Fragment>
</Base>
