---
interface Props {
  title: string;
  note?: string;
}
const { title, note } = Astro.props;
---

<div class="mb-6 flex flex-wrap items-baseline justify-between gap-x-4 gap-y-1">
  <h2 class="text-xl font-semibold tracking-tight sm:text-2xl">{title}</h2>
  {note && <p class="text-muted-foreground text-sm">{note}</p>}
  <slot />
</div>
